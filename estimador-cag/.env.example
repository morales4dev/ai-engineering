# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LiteLLM call deadline (seconds). Instructor re-prompts up to max_retries=6
# inside complete_structured. Settings default stays 30; this file is 600
# because gpt-5 reasoning dies at 30s. Copy into the real .env and recreate
# estimator before any live gpt-5 call.
LLM_TIMEOUT=600

# PRIMARY_MODEL is the boot default for estimation calls. Ajustes can override
# it at runtime (Redis); «Por defecto» comes back here.
# There is no FALLBACK_MODEL and no auto-retry onto another model.
PRIMARY_MODEL=gpt-4o-mini

# Exact-match cache. If Redis is down the service still answers (miss + warning).
# Semantic cache needs Redis Stack (RediSearch), not vanilla redis:7-alpine.
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

# Semantic cache (redisvl + embeddings). Disabled without OPENAI_API_KEY or RediSearch.
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_TTL=86400
# When true, look up and log would-be hits but do not serve them.
SEMANTIC_CACHE_LOG_ONLY=false

# Persistent history. Compose overrides this to the in-network postgres host.
# When running uvicorn on the host, point at localhost. Missing URL skips writes.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/estimator

# --- Session 6 — catalog + ingestion + PII (host defaults; not required in .env) ---
# Settings already default these for the host. Compose sets CATALOG_PATH and
# INGESTION_DATA_ROOT to /app/data/.... Do not copy these five into the machine .env.
# CATALOG_PATH=<estimador-cag>/data/catalog/catalog.yaml
# INGESTION_DATA_ROOT=<estimador-cag>/data/seed
# PRESIDIO_SPACY_MODEL=es_core_news_md
# PSEUDONYM_FAKER_LOCALE=es_ES
# PSEUDONYM_HASH_SALT=change-me-in-prod

# Streamlit talks to FastAPI over HTTP. Point this at wherever the API listens.
ESTIMATOR_API_BASE_URL=http://localhost:8000

# Sliding-window size for conversational sessions (user+assistant pairs).
# In-process only; restart empties the store.
MAX_CONVERSATION_TURNS=6

# Per-attachment text cap after local extraction (Camino B). Truncate, do not 413.
MAX_ATTACHMENT_CHARS=60000

# Second-pass facts extractor after each session estimate. Fail-open on error.
METADATA_EXTRACTOR_MODEL=gpt-4o-mini

# Compression. heuristic is default (no LLM). llm classifies each
# evicted user turn; failure falls back to heuristic. Summarizer is fail-open.
ANCHOR_DETECTION_MODE=heuristic
COMPRESSION_MODEL=gpt-4o-mini

# Session estimate default when ?prompt_version= is omitted. One-shot stays v1.
CONVERSATIONAL_PROMPT_VERSION=v3

# Actor-Critic-Boss. Critic fail-open. Boss loops at most this many actor calls.
CRITIC_MODEL=gpt-4o-mini
BOSS_MAX_ITERATIONS=3

# --- Session 7 live — paid chunker models (defaults in Settings; not required in .env) ---
# Settings already default these. Do not copy these two into the machine .env
# unless you want to override. They are unused until strategies are wired.
PROPOSITIONAL_CHUNKER_MODEL=gpt-4o-mini
CONTEXTUAL_CHUNKER_MODEL=claude-sonnet-4-5

# --- Session 9 — RAG estimation (transcript → grounded estimate) --------------
# Two independent API keys. Clients send them as X-API-Key.
# Streamlit sends ESTIMATE_API_KEY as X-API-Key (wizard + from-transcript).
# RETRIEVAL_API_KEY is only for POST /v1/retrieval/search. Do not merge them:
# a client that may search must not be allowed to spend gpt-5 on generate.
# These DEMO values enable the routers; leave blank to disable (every request → 401).
RETRIEVAL_API_KEY=demo-retrieval-key
ESTIMATE_API_KEY=demo-estimate-key

# Models for the RAG pipeline (both go through LLMWrapper / Instructor).
# Not switchable from Ajustes (not in MODEL_KEYS). Override via .env.
REFORMULATION_MODEL=gpt-5-mini
GENERATION_MODEL=gpt-5
# "high" drives a deeper module→task decomposition (granular modular breakdown).
GENERATION_REASONING_EFFORT=high
# Token ceiling (reasoning + output) for the RAG structured calls. gpt-5 spends
# reasoning tokens against this budget, so the 4000 wrapper default truncates
# the JSON (finish_reason='length' → 502). 64000 leaves room for high-effort
# reasoning + the larger nested (modules→tasks) output. A cap, not a target.
GENERATION_MAX_TOKENS=64000

# Retrieval knobs (locked defaults).
RETRIEVAL_TOP_K=10
RETRIEVAL_DISTANCE_THRESHOLD=0.6

# Token budget for the assembled <source> context block (tiktoken cl100k_base).
MAX_CONTEXT_TOKENS=16384

# Idempotency cache TTL (seconds) for POST /v1/estimate/from-transcript. Uses
# REDIS_URL when set; otherwise an in-process dict fallback.
IDEMPOTENCY_TTL=86400

# Application
APP_ENV=development
LOG_LEVEL=DEBUG
