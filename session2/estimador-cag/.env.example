# LLM Provider configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

#
LLM_PROVIDER=openai
# Default model for the configured provider. Can be overridden per request via
# the "model" field in POST /api/v1/estimate (handy for live A/B comparisons
# without restarting the server).
LLM_MODEL=gpt-4.1-nano

# LiteLLM call deadline (seconds) and retry count. Without these, LiteLLM
# inherits SDK defaults that can hang a worker for many minutes.
LLM_TIMEOUT=30
LLM_RETRIES=2

# LiteLLM Router: PRIMARY_MODEL first, FALLBACK_MODEL if that call fails.
# A per-request "model" override bypasses the Router (no fallback).
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001

# Exact-match cache. If Redis is down the service still answers (miss + warning).
REDIS_URL=redis://localhost:6379
CACHE_TTL=86400

# Application
APP_ENV=development
LOG_LEVEL=DEBUG
